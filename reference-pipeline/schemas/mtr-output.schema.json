{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mtr-reference-output-v1.schema.json",
  "title": "Generic bilingual MTR output",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "document", "chapters"],
  "properties": {
    "formatVersion": { "const": 1 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceLanguage", "targetLanguage", "title", "version", "effectiveDate"],
      "properties": {
        "id": { "const": "mtr" },
        "sourceLanguage": { "const": "en" },
        "targetLanguage": { "type": "string", "minLength": 2 },
        "title": { "$ref": "#/$defs/translatedText" },
        "version": { "type": "string", "pattern": "^[0-9]{8}$" },
        "effectiveDate": { "type": "string", "format": "date" }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "translatedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "translation"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "en", "translation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["paragraph", "list", "table", "markdown", "image"] },
        "en": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 },
        "extras": {
          "type": "array",
          "items": { "$ref": "#/$defs/translatedText" }
        }
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/content" }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "en", "translation", "contents"],
      "properties": {
        "id": { "type": "string" },
        "chapter": { "type": "string" },
        "en": { "type": "string" },
        "translation": { "type": "string" },
        "contents": { "$ref": "#/$defs/contents" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "en", "translation"],
      "properties": {
        "id": { "type": "string" },
        "chapter": { "type": "string" },
        "en": { "type": "string" },
        "translation": { "type": "string" },
        "contents": { "$ref": "#/$defs/contents" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        }
      },
      "oneOf": [
        { "required": ["contents"] },
        { "required": ["sections"] }
      ]
    }
  }
}
